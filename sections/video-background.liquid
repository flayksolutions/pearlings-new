{{ 'component-video-background.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign st = section.settings
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-section m-video-background'
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
  assign classes = classes | append: ' m-gradient' | append: ' m-color-' | append: section.settings.color_scheme

  assign data_type = 'mp4'
  assign video_url = st.shopify_video
  case st.video_type
    when 'external'
      assign video_url = st.video_url
      if st.video_url.type == 'youtube'
        assign data_type = 'youtube'
      else
        assign data_type = 'vimeo'
      endif
  endcase
-%}
<section
  data-section-type="video-background"
  data-section-id="{{ section.id }}"
  class="{{ classes }}"
>
  <div class="{{ container }}">
    <div class="m-video-background__wrapper">
      <div class="m-video-background__media m-video-background__media--{{ section.settings.video_height }}{% if container != 'container-full' %} m:blocks-radius{% endif %}">
        {% if video_url != blank %}
          <m-video-component
            class="m-video-background__video"
            data-init="false"
            data-type="{{ data_type }}"
            data-video-id="{{ st.video_url.id }}"
          >
            {% if st.video_type == 'external' %}
              <video src="{{ video_url }}" playsinline autoplay muted loop></video>
            {% else %}
              {{-
                st.shopify_video
                | video_tag:
                  playsinline: true,
                  muted: true,
                  autoplay: true,
                  loop: true,
                  controls: false,
                  preload: 'none',
                  image_size: '1500x'
              -}}
            {% endif %}
          </m-video-component>
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
        {% endif %}
      </div>
      {% if section.blocks.size > 0 %}
        <div class="m-video-background__content m-video-background__content--{{ section.settings.content_position }} m:text-{{ section.settings.text_alignment }}{% if section.settings.use_content_in_container %} container{% endif %}">
          <div class="m-video-background__content-box m:blocks-radius-md m-gradient m-color-{{ section.settings.color_scheme }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'heading' %}
                  {% if block.settings.heading != blank %}
                    <h2 class="m-section__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
                  {% endif %}
                {% when 'subheading' %}
                  {% if block.settings.subheading != blank %}
                    <p class="m-section__subheading m:uppercase">{{ block.settings.subheading }}</p>
                  {% endif %}
                {% when 'text' %}
                  {% if block.settings.text != blank %}
                    <div class="m-section__description rte {{ block.settings.text_size | prepend: 'm:' }}">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                {% when 'button' %}
                  {% if block.settings.button_label != blank %}
                    <a
                      href="{{ block.settings.button_link }}"
                      class="m:w-full m-button {{ block.settings.button_style | replace: 'sf__btn-primary', 'm-button--primary' | replace: 'sf__btn-secondary', 'm-button--secondary' | replace: 'sf__btn-link', 'm-button--link' | replace: 'sf__btn-white', 'm-button--white' }}"
                    >
                      {{- block.settings.button_label -}}
                    </a>
                  {% endif %}
                {% else %}

              {% endcase %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Video background",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "w-full",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Video settings"
    },
    {
      "type": "select",
      "id": "video_type",
      "label": "Video type",
      "default": "shopify",
      "options": [
        {
          "value": "shopify",
          "label": "Shopify hosted"
        },
        {
          "value": "external",
          "label": "External"
        }
      ]
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Shopify hosted"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "External video url"
    },
    {
      "type": "select",
      "id": "video_height",
      "label": "Height",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "middle-left",
      "options": [
        {
          "label": "Top left",
          "value": "top-left"
        },
        {
          "label": "Top center",
          "value": "top-center"
        },
        {
          "label": "Top right",
          "value": "top-right"
        },
        {
          "label": "Middle left",
          "value": "middle-left"
        },
        {
          "label": "Middle center",
          "value": "middle-center"
        },
        {
          "label": "Middle right",
          "value": "middle-right"
        },
        {
          "label": "Bottom left",
          "value": "bottom-left"
        },
        {
          "label": "Bottom center",
          "value": "bottom-center"
        },
        {
          "label": "Bottom right",
          "value": "bottom-right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_content_in_container",
      "label": "Use content in container box",
      "default": false
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit global setting" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-in-up", "label": "Fade in up" },
        { "value": "fade-in-right", "label": "Fade in right" }
      ]
    },
    {
      "type": "header",
      "content": "Custom Attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our story"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h3",
          "options": [
            {
              "label": "Heading xs",
              "value": "h6"
            },
            {
              "label": "Heading sm",
              "value": "h5"
            },
            {
              "label": "Heading md",
              "value": "h4"
            },
            {
              "label": "Heading lg",
              "value": "h3"
            },
            {
              "label": "Heading xl",
              "value": "h2"
            },
            {
              "label": "Heading 2xl",
              "value": "h1"
            }
          ]
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Sub heading",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Subheading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Tell your brand's story with a background video that brings your products to life.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "default": "text-base",
          "options": [
            {
              "label": "Small",
              "value": "text-sm"
            },
            {
              "label": "Base size",
              "value": "text-base"
            },
            {
              "label": "Large",
              "value": "text-lg"
            },
            {
              "label": "Extra large",
              "value": "text-xl"
            },
            {
              "label": "Default",
              "value": "text-default"
            }
          ]
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "m-button--primary",
              "label": "Primary button"
            },
            {
              "value": "m-button--secondary",
              "label": "Secondary button"
            },
            {
              "value": "m-button--white",
              "label": "White button"
            },
            {
              "value": "m-button--link",
              "label": "Underline button"
            }
          ],
          "default": "m-button--primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video background",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
