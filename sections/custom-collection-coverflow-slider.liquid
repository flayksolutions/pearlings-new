{% comment %}
  ============================================================
  Category Coverflow Slider  (sections/category-coverflow.liquid)
  ------------------------------------------------------------
  Swiper.js "coverflow" slider of portrait category cards.
  - Center card is upright + full colour, side cards tilt in 3D and dim.
  - Each card has a bottom label that re-centers + grows when active.
  - Round nav arrows over the side cards.

  Install:
    1. Put this file in   sections/category-coverflow.liquid
    2. Put the CSS in      assets/category-coverflow.css
    3. Put the JS in       assets/category-coverflow.js
    4. Add the section to any template (or use it as a JSON-template section).

  Swiper is loaded from the jsDelivr CDN below. To self-host, download
  swiper-bundle.min.css / swiper-bundle.min.js into /assets and swap the
  CDN tags for {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}.
  ============================================================
{% endcomment %}

{{ 'custom-collection-coverflow-slider.css' | asset_url | stylesheet_tag }}

{%- comment -%} Swiper core (CDN). Loaded once even with multiple sections. {%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="{{ 'custom-collection-coverflow-slider.js' | asset_url }}" defer></script>

{%- liquid
  assign sec = section.id
  assign s = section.settings
  assign section_classes = 'coverflow-section m-gradient m-color-' | append: s.color_scheme
-%}

<section
  class="{{ section_classes }}"
  style="
    --cc-card-w: {{ s.card_width }}px;
    --cc-card-radius: {{ s.card_radius }}px;
    --cc-gap: {{ s.space_between }}px;
    --cc-dim: {{ s.side_dim | divided_by: 100.0 }};
    --cc-label-size: {{ s.label_size }}px;
    --cc-label-tracking: {{ s.label_tracking }}px;
    --cc-text: {{ s.label_color }};
    --cc-section-pad: {{ s.section_padding }}px;
  "
>
  {%- if s.heading != blank -%}
    <h2 class="coverflow-section__heading">{{ s.heading }}</h2>
  {%- endif -%}

  <div class="coverflow" id="coverflow-{{ sec }}">
    <div
      class="coverflow__swiper swiper"
      data-coverflow
      data-loop="{{ s.loop }}"
      data-autoplay="{{ s.autoplay }}"
      data-autoplay-delay="{{ s.autoplay_delay }}"
      data-rotate="{{ s.cf_rotate }}"
      data-depth="{{ s.cf_depth }}"
      data-stretch="{{ s.cf_stretch }}"
      data-modifier="{{ s.cf_modifier }}"
    >
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign tag = 'div'
            if b.link != blank
              assign tag = 'a'
            endif
          -%}
          <div class="swiper-slide coverflow__slide" {{ block.shopify_attributes }}>
            <{{ tag }}
              class="coverflow__card"
              {% if b.link != blank %}href="{{ b.link }}" aria-label="{{ b.title | escape }}"{% endif %}
            >
              <div class="coverflow__media">
                {%- if b.image != blank -%}
                  {{
                    b.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(max-width: 749px) 70vw, 360px',
                      widths: '300, 360, 450, 540, 720, 900',
                      class: 'coverflow__img',
                      alt: b.title
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'coverflow__img coverflow__img--placeholder' }}
                {%- endif -%}
                <span class="coverflow__overlay" aria-hidden="true"></span>
              </div>

              {%- if b.title != blank -%}
                <div class="coverflow__caption">
                  <span class="coverflow__label">{{ b.title }}</span>
                </div>
              {%- endif -%}
            </{{ tag }}>
          </div>
        {%- else -%}
          {%- comment -%} Fallback so the section is visible in a fresh theme {%- endcomment -%}
          {%- for i in (1..4) -%}
            <div class="swiper-slide coverflow__slide">
              <div class="coverflow__card">
                <div class="coverflow__media">
                  {{ 'image' | placeholder_svg_tag: 'coverflow__img coverflow__img--placeholder' }}
                  <span class="coverflow__overlay" aria-hidden="true"></span>
                </div>
                <div class="coverflow__caption">
                  <span class="coverflow__chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                      <path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span class="coverflow__label">Category {{ i }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if s.show_arrows -%}
      <button type="button" class="coverflow__nav coverflow__nav--prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="coverflow__nav coverflow__nav--next" aria-label="Next">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Category Coverflow",
  "tag": "section",
  "class": "section-category-coverflow",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by look" },

    { "type": "header", "content": "Layout" },
    {
      "type": "range", "id": "card_width", "label": "Card width",
      "min": 220, "max": 460, "step": 10, "unit": "px", "default": 340
    },
    {
      "type": "range", "id": "card_radius", "label": "Card corner radius",
      "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4
    },
    {
      "type": "range", "id": "space_between", "label": "Space between cards",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range", "id": "section_padding", "label": "Section vertical padding",
      "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56
    },

    { "type": "header", "content": "Coverflow 3D effect" },
    {
      "type": "range", "id": "cf_rotate", "label": "Side card rotation",
      "min": 0, "max": 60, "step": 1, "unit": "°", "default": 38
    },
    {
      "type": "range", "id": "cf_depth", "label": "Depth (push back)",
      "min": 0, "max": 400, "step": 10, "unit": "px", "default": 120
    },
    {
      "type": "range", "id": "cf_stretch", "label": "Stretch (overlap)",
      "min": -60, "max": 120, "step": 5, "unit": "px", "default": 0
    },
    {
      "type": "range", "id": "cf_modifier", "label": "Effect multiplier",
      "min": 1, "max": 4, "step": 1, "default": 1
    },
    {
      "type": "range", "id": "side_dim", "label": "Side card dimming",
      "min": 0, "max": 80, "step": 5, "unit": "%", "default": 50
    },

    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    {
      "type": "range", "id": "autoplay_delay", "label": "Autoplay delay",
      "min": 1000, "max": 8000, "step": 500, "unit": "ms", "default": 3500
    },

    { "type": "header", "content": "Label" },
    {
      "type": "range", "id": "label_size", "label": "Label size",
      "min": 12, "max": 36, "step": 1, "unit": "px", "default": 18
    },
    {
      "type": "range", "id": "label_tracking", "label": "Label letter spacing",
      "min": 0, "max": 8, "step": 1, "unit": "px", "default": 2
    },
    { "type": "color", "id": "label_color", "label": "Label colour", "default": "#ffffff" },

    { "type": "header", "content": "Label colour" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Label", "default": "Day out" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Category Coverflow",
      "blocks": [
        { "type": "slide", "settings": { "title": "Day out" } },
        { "type": "slide", "settings": { "title": "Date night" } },
        { "type": "slide", "settings": { "title": "Wedding wear" } },
        { "type": "slide", "settings": { "title": "Office wear" } },
        { "type": "slide", "settings": { "title": "Party wear" } }
      ]
    }
  ]
}
{% endschema %}
