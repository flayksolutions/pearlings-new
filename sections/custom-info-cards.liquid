{{ 'multiple-iwt.css' | asset_url | stylesheet_tag }}
{{ 'custom-info-cards.css' | asset_url | stylesheet_tag }}

{% liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  assign layout = section.settings.layout

  assign columns = section.settings.columns
  assign columns_tablet = columns
  if columns_tablet > 2
    assign columns_tablet = 2
  endif
  assign columns_mobile = section.settings.columns_mobile
%}

{%- style -%}
  .m-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --column-gap-mobile: {{ section.settings.column_gap_mobile }}px;
  }
{%- endstyle -%}

<section
  id="m-section-{{ section.id }}"
  class="m-section m-section-{{ section.id }} m-info-cards {{ section.settings.custom_class }} m-gradient m-color-{{ section.settings.color_scheme }}"
>
  <div class="{{ container }} m-section-my m-section-py">
    {% render 'index-section-header', section_settings: section.settings %}
    <div class="m-section__inner">
      <div class="m-info-cards__grid m:display-grid m:grid-{{ columns_mobile }}-cols md:m:grid-{{ columns_tablet }}-cols lg:m:grid-{{ columns }}-cols">
        {% for block in section.blocks %}
          {% render 'info-card',
            block: block,
            layout: layout,
            section_color_scheme: section.settings.color_scheme,
            animated: animated,
            animation_effect: animation_effect
          %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
