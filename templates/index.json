    "custom_testimonials_BMygJi": {
      "type": "custom-testimonials",
      "blocks": {
        "testimonial_aaLkq7": {
          "type": "testimonial",
          "settings": {
            "row": "1",
            "name": "aleesha nadeem",
            "role": "6 months ago",
            "rating": 5,
            "testimonial": "Absolutely beautiful jewelry and such an amazing variety to choose from! Every piece is unique and eye-catching, and there’s always something new to discover. They also often have great sales, which makes it even better. The owner is incredibly sweet, welcoming, and genuinely helpful—she makes the whole experience so enjoyable. Highly recommend checking this place out!"
          }
        },
        "testimonial_3xeXHi": {
          "type": "testimonial",
          "settings": {
            "row": "2",
            "name": "Halle Tims",
            "role": "5 months ago",
            "rating": 5,
            "testimonial": "So glad I walked into this store! The store is filled with beautiful things! I’ll definitely be back & i caught some things on sale ☺️"
          }
        },
        "testimonial_hr6aKW": {
          "type": "testimonial",
          "settings": {
            "row": "1",
            "name": "Aarifa Qazi",
            "role": "3 months ago",
            "rating": 5,
            "testimonial": "I had a wonderful experience at Pearlings. The jewelry selection is beautiful, but what truly made my visit special was the exceptional service from Dilshad. She was incredibly helpful, patient, and knowledgeable. Dilshad took the time to help me select several lovely sets for an upcoming family wedding and made the whole experience enjoyable and stress-free.\n\nHer attention to detail and genuine care for the customer really stood out. I’m very grateful for her help and would highly recommend Pearlings, and especially Dilshad, to anyone looking for beautiful jewelry and excellent service."
          }
        },
        "testimonial_4qQeTc": {
          "type": "testimonial",
          "settings": {
            "row": "2",
            "name": "Mailynn Nguyen",
            "role": "2 months ago",
            "rating": 5,
            "testimonial": "My experience here at Pearlings was great. When you walk in you’re greeted by multiple people that will help you. Abbas is the owner and he’s very nice and helpful. Everything I tried on got me closer to the indian jewelry I needed. I came in for bridal jewelry and was able to find everything I needed here. Abbas has a good eye for jewelry and is able to customize any set so it will fit you exactly how you need."
          }
        },
        "testimonial_Gia8Qm": {
          "type": "testimonial",
          "settings": {
            "row": "1",
            "name": "Ellen Garre",
            "role": "6 months ago",
            "rating": 5,
            "testimonial": "Pearlings provides exceptional custom jewelry services. The quality of their craftsmanship and attention to detail are outstanding. I was pleasantly surprised by the quick turnaround time—my piece was completed in just two days, far sooner than expected. I highly recommend Pearlings and will certainly return for future jewelry needs."
          }
        },
        "testimonial_8GTYEa": {
          "type": "testimonial",
          "settings": {
            "row": "2",
            "name": "Lauren McDonald",
            "role": "1 year ago",
            "rating": 5,
            "testimonial": "Amazing store that outfits me for my Nikkah and Walima.\n\nI came in with a general idea of what I wanted for my wedding jewelry to look like, and they exceeded my expectations. I wanted to have a simple look, and they accepted the challenge. They far exceeded everything and will continue to come back for my jewelry needs."
          }
        },
        "testimonial_Yi3JBL": {
          "type": "testimonial",
          "settings": {
            "row": "1",
            "name": "Sherebanu Ramakdawala",
            "role": "1 year ago",
            "rating": 5,
            "testimonial": "This is the perfect place for wedding jewelry shopping! The service is exceptional, with the owner and staff being incredibly helpful. They assisted me in finding jewelry to complement all my outfits, and the best part is their ability to customize sets to match my attire perfectly."
          }
        },
        "testimonial_AjD9rd": {
          "type": "testimonial",
          "settings": {
            "row": "2",
            "name": "Jay Edwards",
            "role": "1 month ago",
            "rating": 5,
            "testimonial": "I love this place! The people are so nice. The jewelry beautiful and they always have great prices."
          }
        },
        "testimonial_TQRWFX": {
          "type": "testimonial",
          "settings": {
            "row": "1",
            "name": "Leah",
            "role": "2 months ago",
            "rating": 5,
            "testimonial": "The ladies were very kind and helpful to my mother. They worked extra hard and 20 minutes past closing to help match jewelry to her dupatta. The store also had a very large selection of jewelry, shoes, bags, and more! I definitely recommend this place."
